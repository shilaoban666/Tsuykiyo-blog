# PostgreSQL 连接串。默认使用本机 PostgreSQL。
DATABASE_URL=postgres://postgres:123456@127.0.0.1:5432/tsukiyo_blog

# 站点地址（用于 RSS / sitemap / 分享卡片）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 会话签名密钥，部署前务必改成随机长字符串
AUTH_SECRET=replace-with-a-long-random-string

# 首次初始化时创建的管理员账号
ADMIN_EMAIL=admin@tsukiyo.local
ADMIN_PASSWORD=tsukiyo2026
ADMIN_NAME=月白主人